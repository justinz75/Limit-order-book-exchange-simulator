{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "C/C++: build order-book tests",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/I${workspaceFolder}\\include",
                "/I${workspaceFolder}\\.vscode",
                "/Fe${workspaceFolder}\\tests\\order_book_tests.exe",
                "${workspaceFolder}\\tests\\order_book_tests.cpp",
                "${workspaceFolder}\\src\\order_book.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ],
    "version": "2.0.0"
}